# ===============================
#  Chaos-style: two-column (balanced)
# ===============================

# Figure size and DPI (approx. full text width)
figure.figsize: 7.0, 3.0
figure.dpi: 300

# Backgrounds
figure.facecolor: white
axes.facecolor: white

# Fonts (balanced)
font.family: serif
font.serif: Times New Roman, Times, DejaVu Serif
font.size: 9          # base
axes.labelsize: 10    # axis labels a bit larger than base
axes.titlesize: 10
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
mathtext.fontset: stix

# Axes
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.6
axes.labelpad: 2
axes.grid: False

# Ticks
xtick.major.size: 3
ytick.major.size: 3
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.direction: in
ytick.direction: in

# Lines (a bit lighter so curves don't crowd)
lines.linewidth: 0.9
lines.markersize: 2.0

# Legend
legend.frameon: False

# Saving
savefig.transparent: False
savefig.bbox: tight
savefig.facecolor: white

# Color cycle (must be a single valid cycler expression on one line)
axes.prop_cycle: cycler('color', ["#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd", "#8c564b", "#e377c2", "#7f7f7f"])
